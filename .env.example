# Copy this file to .env and fill in actual values
# .env is gitignored and will not be committed

# Logging
CDAQ_LOG_LEVEL=info

# RabbitMQ
CDAQ_RABBITMQ_URI=amqp://guest:guest@localhost:5672/
CDAQ_RABBITMQ_QUEUE=aml.screening.ogs
CDAQ_RABBITMQ_EXCHANGE=aml.screening.ogs
CDAQ_RABBITMQ_ROUTING_KEY=event.#
CDAQ_RABBITMQ_PREFETCH_COUNT=10

# MongoDB
CDAQ_MONGODB_URI=mongodb://localhost:27017
CDAQ_MONGODB_DATABASE=cdaq
CDAQ_MONGODB_COLLECTION=events
CDAQ_MONGODB_JOB_COLLECTION=jobs
CDAQ_MONGODB_CHILD_JOB_COLLECTION=child_jobs
CDAQ_MONGODB_SCREENING_WC_RESULT_COLLECTION=screening_wc_results

# AI Model (REQUIRED - set via environment variable)
CDAQ_AIMODEL_TYPESAFE_API_KEY=your-typesafe-api-key-here
